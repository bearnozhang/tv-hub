# Cloudflare Pages / Workers 静态资源响应头
# 规则：同名头只在一条规则里出现一次，路径必须互不重叠，
# 否则 Cloudflare Pages 会把多个命中的同名头拼成 "a, a"。

/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

/*.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300

# 这些 .txt 实际承载 JSON（多仓订阅/TVBox 配置），强制按 JSON 返回
/sub.txt
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300

/live-sub.txt
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300

/live-mini.txt
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300

/live-lite.txt
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300

/live-standard.txt
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300

/live-full.txt
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300

# /live.txt 是真正的纯文本直播源（分组,#genre# 格式），
# 不要在 _headers 里覆盖其 Content-Type，保留默认 text/plain
